# =====================================
# Learning.AI Backend — Environment Variables
# Copy this file to .env and fill in values.
# NEVER commit .env to git.
# =====================================

# ------------------------------------
# SERVER
# ------------------------------------
PORT=8080
NODE_ENV=development
# VERCEL is set automatically by Vercel — do not set manually.

# ------------------------------------
# DATABASE
# ------------------------------------
# Primary MongoDB Atlas connection string
MONGODB_URI=

# Optional separate DB for exam data (falls back to localhost if unset)
EXAM_MONGODB_URI=

# Test database (used when NODE_ENV=test)
MONGODB_TEST_URI=

# ------------------------------------
# JWT AUTHENTICATION
# ------------------------------------
JWT_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

# Password hashing pepper (optional but recommended)
PEPPER=

# ------------------------------------
# SESSION
# ------------------------------------
SESSION_SECRET=

# ------------------------------------
# COOKIE SETTINGS
# Set to "true" in production. Vercel sets NODE_ENV=production automatically.
# ------------------------------------
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# ------------------------------------
# CORS / FRONTEND
# ------------------------------------
FRONTEND_URL=http://localhost:5173
# Comma-separated list of additional allowed origins:
# FRONTEND_URLS=https://staging.example.com,https://preview.example.com

# Used by google OAuth callback and redirect
BACKEND_URL=http://localhost:8080

# ------------------------------------
# GOOGLE OAUTH (optional — app boots without these)
# ------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:8080/auth/google/callback

# ------------------------------------
# AI SERVICES
# ------------------------------------
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# Timeout in milliseconds for AI API calls
AI_SERVICE_TIMEOUT=30000

# ------------------------------------
# EMAIL / AWS SES (OTP sending)
# ------------------------------------
# SES region (sandbox is in us-east-1)
SES_REGION=us-east-1
# Explicit IAM credentials for SES — leave blank to use the SDK default chain
SES_AWS_ACCESS_KEY_ID=
SES_AWS_SECRET_ACCESS_KEY=
# Verified sender address (must be verified in SES)
EMAIL_FROM=

# ------------------------------------
# OTP
# ------------------------------------
# HMAC key for hashing OTP codes (required)
OTP_SECRET=

# ------------------------------------
# YOUTUBE API (video links population script)
# ------------------------------------
YOUTUBE_API_KEY=

# ------------------------------------
# CONTENT CACHE
# ------------------------------------
CONTENT_CACHE_TTL_DAYS=30

# ------------------------------------
# RATE LIMITING (optional overrides)
# ------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ------------------------------------
# VERCEL CRON (protect cron endpoints)
# ------------------------------------
CRON_SECRET=

# ------------------------------------
# CLOUD RECORDING STORAGE (AWS S3 or Cloudflare R2)
# Required to enable proctoring video chunk uploads.
# If any of STORAGE_BUCKET / STORAGE_ACCESS_KEY_ID / STORAGE_SECRET_ACCESS_KEY
# are missing the recording feature is silently disabled — exams still run.
# ------------------------------------

# Set to "false" to fully disable recording even when credentials are present
RECORDING_ENABLED=true

# S3-compatible bucket name (e.g. learning-ai-file-upload)
STORAGE_BUCKET=

# AWS region for the bucket (e.g. ap-south-1). Use "auto" for Cloudflare R2.
STORAGE_REGION=ap-south-1

# IAM/R2 access credentials (write + ListBucket on recordings/* path only)
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# Custom endpoint URL for S3-compatible providers (Cloudflare R2, MinIO).
# Leave blank to use standard AWS S3 endpoints.
STORAGE_ENDPOINT=
